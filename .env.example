# Environment variable template for the Portfolio Predictive Engine.
# Copy this file to .env and fill in the real values.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=portfolio_engine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Angel One SmartAPI credentials (never commit the real .env file)
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=

# HuggingFace model cache (optional – defaults to .hf_cache in project root)
HF_MODEL_CACHE=.hf_cache

# Logging
DJANGO_LOG_LEVEL=INFO
